        "widget": "./KeepAwakeWidget.qml"
    },
    "settings": "./KeepAwakeSettings.qml",
    "requires_dms": ">=1.5.0",
    "requires": [
        "systemd-inhibit"
    ],
    "permissions": [
        "settings_read",
        "settings_write"
    ]
