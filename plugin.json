{
    "id": "vibeShift",
    "name": "Vibe Shift",
    "description": "Keep the laptop awake for a set time, even with the lid closed, while your agent works the night shift.",
    "version": "0.1.0",
    "author": "pltanton",
    "license": "MIT",
    "type": "composite",
    "capabilities": [
        "daemon",
        "dankbar-widget",
        "control-center",
        "ipc"
    ],
    "icon": "owl",
    "components": {
        "daemon": "./VibeShiftDaemon.qml",
        "widget": "./VibeShiftWidget.qml"
    },
    "settings": "./VibeShiftSettings.qml",
    "requires_dms": ">=2.0.0",
    "requires": [
        "systemd-run",
        "systemd-inhibit",
        "gdbus"
    ],
    "permissions": [
        "settings_read",
        "settings_write"
    ]
}
