{
    "id": "keepAwake",
    "name": "Keep Awake",
    "description": "Stay awake for a set time, even with the lid closed.",
    "version": "0.1.0",
    "author": "pltanton",
    "license": "MIT",
    "type": "composite",
    "capabilities": [
        "daemon",
        "dankbar-widget",
        "control-center",
        "ipc"
    ],
    "icon": "owl",
